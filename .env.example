# GeoAlpha configuration. Copy to .env and fill in. Never commit .env.

# Engine: "tradingagents" (real LLM run) or "fake" (scripted offline demo, no keys needed)
GEOALPHA_ENGINE=fake
# Geopolitical source: worldmonitor | snapshot | fixture
GEOALPHA_GEO_PROVIDER=fixture
GEOALPHA_DATA_DIR=./data
GEOALPHA_MAX_CONCURRENT_RUNS=2
GEOALPHA_FORECAST_MODEL=NeoQuasar/Kronos-small
# 1 = deterministic synthetic forecast band (fast e2e); 0 = run Kronos
GEOALPHA_FAKE_FORECAST=0

# TradingAgents / LLM
TRADINGAGENTS_LLM_PROVIDER=anthropic
TRADINGAGENTS_DEEP_THINK_LLM=claude-opus-5-5
TRADINGAGENTS_QUICK_THINK_LLM=claude-sonnet-5
ANTHROPIC_API_KEY=

# WorldMonitor (hosted Pro key, or self-hosted URLs + operator key)
WORLDMONITOR_API_KEY=
WORLDMONITOR_BASE_URL=
WORLDMONITOR_MCP_URL=
